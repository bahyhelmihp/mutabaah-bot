[Unit]
Description=Mutabaah Yaumiyah Telegram Bot Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/bahy/aibrain/mutabaah-bot
ExecStart=/home/bahy/aibrain/mutabaah-bot/venv/bin/python -m app.bot
Restart=always
RestartSec=5
EnvironmentFile=/home/bahy/aibrain/mutabaah-bot/.env
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
