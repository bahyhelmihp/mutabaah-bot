# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account Credentials:
# Can be the file path to credentials.json (e.g. ./credentials.json)
# OR the full raw JSON string (useful for Render/Railway/cloud deployments):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials.json

# Comma-separated Telegram User IDs for Admin privileges (e.g., 123456789,987654321)
ADMIN_TELEGRAM_IDS=123456789

# Timezone (IMA Korea uses Asia/Seoul)
TIMEZONE=Asia/Seoul

# Daily reminder schedule (24-hour format)
REMINDER_HOUR=21
REMINDER_MINUTE=0

# Webhook deployment (optional, leave blank for local polling mode)
# WEBHOOK_URL=https://your-domain.onrender.com
# PORT=8080
